rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Existing private user library
    match /trailguideUsers/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bearer-link shares: anyone with the unguessable share URL can read.
    // Only the authenticated owner can create/update/delete a share.
    match /trailguideShares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.ownerUid == request.auth.uid;
    }
  }
}
